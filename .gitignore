# Rust build artifacts (including nested crates)
target/

# Frontend dependencies and build output
/web/node_modules/
/web/dist/

# rustfmt backup files
**/*.rs.bk

# Profiling output
*.profraw
*.profdata

# RustRover / JetBrains IDE project settings and module files
.idea/
*.iml

# macOS metadata
.DS_Store

# Keep Cargo.lock and web/package-lock.json tracked for reproducible builds.

/web/test-results/
/web/playwright-report/

# Local conversations
.cola/

# Automation dependencies, compiled output and local runtime state
__pycache__/
*.pyc

# Local implementation notes and verification artifacts
.scratch/
